# Copy this file to .env.local for local development with `vercel dev`.
# In production these are set directly in the Vercel dashboard
# (Project → Settings → Environment Variables) — never commit real values.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
DRIVE_PHOTOS_FOLDER_ID=your-drive-folder-id
